rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- PHASE 3: Primitives ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    // We check if the email is yokotenkaizen@gmail.com
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified() && request.auth.token.email == 'yokotenkaizen@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- PHASE 4: Validation Blueprints (Resilient Schema Validators) ---

    function isValidWord(data) {
      return data.keys().size() <= 8
        && (!data.keys().hasAny(['word']) || (data.word is string && data.word.size() > 0 && data.word.size() <= 100))
        && (!data.keys().hasAny(['category']) || (data.category is string && data.category.size() > 0 && data.category.size() <= 50))
        && (!data.keys().hasAny(['definition']) || (data.definition is string && data.definition.size() > 0 && data.definition.size() <= 2000))
        && (!data.keys().hasAny(['examples']) || (data.examples is list && data.examples.size() <= 10))
        && (!data.keys().hasAny(['etymology']) || (data.etymology is string && data.etymology.size() <= 1000))
        && (!data.keys().hasAny(['updatedAt']) || data.updatedAt is string)
        && (!data.keys().hasAny(['searchCount']) || data.searchCount is int);
    }

    // Evaluates checks and stats logged securely
    function isValidEvaluation(data) {
      return data.keys().size() <= 7
        && (!data.keys().hasAny(['email']) || (data.email is string && data.email.size() <= 128))
        && (!data.keys().hasAny(['totalWords']) || data.totalWords is int)
        && (!data.keys().hasAny(['typosCount']) || data.typosCount is int)
        && (!data.keys().hasAny(['precision']) || (data.precision is string && data.precision.size() <= 20))
        && (!data.keys().hasAny(['inputText']) || (data.inputText is string && data.inputText.size() <= 100000))
        && (!data.keys().hasAny(['timestamp']) || data.timestamp is string);
    }

    // Fully flexible user mapping (to avoid merge update issues on missing values)
    function isValidTypoUser(data) {
      return data.keys().size() <= 6
        && (!data.keys().hasAny(['email']) || (data.email is string && data.email.size() <= 128))
        && (!data.keys().hasAny(['usageCount']) || (data.usageCount is int || data.usageCount is float))
        && (!data.keys().hasAny(['paymentStatus']) || (data.paymentStatus is string && data.paymentStatus.size() <= 20))
        && (!data.keys().hasAny(['allowedLimit']) || (data.allowedLimit is int || data.allowedLimit is float));
    }

    // Payment logs
    function isValidPayment(data) {
      return data.keys().size() <= 6
        && (!data.keys().hasAny(['email']) || (data.email is string && data.email.size() <= 128))
        && (!data.keys().hasAny(['amount']) || (data.amount is int || data.amount is float))
        && (!data.keys().hasAny(['status']) || (data.status is string && data.status.size() <= 20))
        && (!data.keys().hasAny(['requestedAt']) || data.requestedAt is string)
        && (!data.keys().hasAny(['approvedAt']) || data.approvedAt is string);
    }

    // Global settings configurations
    function isValidSettings(data) {
      return data.keys().size() <= 4
        && (!data.keys().hasAny(['gopayNumber']) || (data.gopayNumber is string && data.gopayNumber.size() <= 50))
        && (!data.keys().hasAny(['qrisImageUrl']) || (data.qrisImageUrl is string && data.qrisImageUrl.size() <= 1500000))
        && (!data.keys().hasAny(['amount']) || (data.amount is int || data.amount is float));
    }

    // White-listed items can bypass checks
    function isValidBypassEmail(data) {
      return data.keys().size() <= 5
        && (!data.keys().hasAny(['email']) || (data.email is string && data.email.size() <= 128))
        && (!data.keys().hasAny(['isActive']) || data.isActive is bool)
        && (!data.keys().hasAny(['createdAt']) || data.createdAt is string);
    }

    // Typo dictionary entries
    function isValidTypoCorrection(data) {
      return data.keys().size() <= 4
        && (!data.keys().hasAny(['typo']) || (data.typo is string && data.typo.size() > 0 && data.typo.size() <= 100))
        && (!data.keys().hasAny(['correction']) || (data.correction is string && data.correction.size() > 0 && data.correction.size() <= 100))
        && (!data.keys().hasAny(['updatedAt']) || data.updatedAt is string);
    }

    // Products offered in Pustaka Digital
    function isValidLibraryProduct(data) {
      return data.keys().size() <= 10
        && (!data.keys().hasAny(['title']) || (data.title is string && data.title.size() <= 200))
        && (!data.keys().hasAny(['description']) || (data.description is string && data.description.size() <= 2000))
        && (!data.keys().hasAny(['format']) || (data.format is string && data.format.size() <= 10))
        && (!data.keys().hasAny(['price']) || (data.price is int || data.price is float))
        && (!data.keys().hasAny(['contentUrl']) || (data.contentUrl is string && data.contentUrl.size() <= 1050000));
    }

    // Library sales logs
    function isValidLibraryPayment(data) {
      return data.keys().size() <= 11
        && (!data.keys().hasAny(['customerName']) || (data.customerName is string && data.customerName.size() <= 128))
        && (!data.keys().hasAny(['customerPhone']) || (data.customerPhone is string && data.customerPhone.size() <= 50))
        && (!data.keys().hasAny(['customerEmail']) || (data.customerEmail is string && data.customerEmail.size() <= 128))
        && (!data.keys().hasAny(['productId']) || (data.productId is string && data.productId.size() <= 128))
        && (!data.keys().hasAny(['productTitle']) || (data.productTitle is string && data.productTitle.size() <= 200))
        && (!data.keys().hasAny(['id']) || (data.id is string && data.id.size() <= 128))
        && (!data.keys().hasAny(['amount']) || (data.amount is int || data.amount is float))
        && (!data.keys().hasAny(['status']) || (data.status is string && data.status.size() <= 50))
        && (!data.keys().hasAny(['requestedAt']) || data.requestedAt is string)
        && (!data.keys().hasAny(['approvedAt']) || data.approvedAt is string);
    }

    // --- PHASE 4: Match collections ---

    // Words collection
    match /words/{wordId} {
      allow read: if true;
      allow create: if isValidId(wordId) && isValidWord(incoming());
      allow update: if isValidWord(incoming())
        || (
          incoming().diff(existing()).affectedKeys().hasOnly(['searchCount'])
        );
      allow delete: if true;
    }

    // Typos collection
    match /typos/{typoId} {
      allow read: if true;
      allow create, update: if isValidId(typoId) && isValidTypoCorrection(incoming());
      allow delete: if true;
    }

    // Stats collection
    match /stats/{statId} {
      allow read: if true;
      allow create, update: if isValidId(statId) 
        && (incoming().keys().size() <= 3)
        && (!incoming().keys().hasAny(['totalSearches']) || (incoming().totalSearches is int || incoming().totalSearches is float))
        && (!incoming().keys().hasAny(['totalInstalls']) || (incoming().totalInstalls is int || incoming().totalInstalls is float));
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if true;
      allow write: if true;
    }

    // Evaluations
    match /evaluations/{evalId} {
      allow create: if isValidId(evalId) && isValidEvaluation(incoming());
      allow read, update, delete: if true;
    }

    // Users (typo usage tracking)
    match /users/{emailId} {
      allow read: if true;
      allow create, update: if isValidId(emailId) && isValidTypoUser(incoming());
      allow delete: if true;
    }

    // Payments logs
    match /payments/{paymentId} {
      allow create: if isValidId(paymentId) && isValidPayment(incoming());
      allow read, update, delete: if true;
    }

    // Settings
    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if isValidId(settingId) && isValidSettings(incoming());
      allow delete: if true;
    }

    // Bypass Whitelist Emails
    match /bypass_emails/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && isValidBypassEmail(incoming());
      allow delete: if true;
    }

    // Library Products
    match /library_products/{productId} {
      allow read: if true;
      allow create, update: if isValidId(productId) && isValidLibraryProduct(incoming());
      allow delete: if true;
    }

    // Library Payments
    match /library_payments/{paymentId} {
      allow read: if true;
      allow create, update: if isValidId(paymentId) && isValidLibraryPayment(incoming());
      allow delete: if true;
    }
  }
}
