rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- PHASE 3: Primitives ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    // We check if the email is yokotenkaizen@gmail.com
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified() && request.auth.token.email == 'yokotenkaizen@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- PHASE 4: Validation Blueprints (Resilient Schema Validators) ---

    function isValidWord(data) {
      return data.keys().size() <= 8
        && (!data.keys().contains('word') || (data.word is string && data.word.size() > 0 && data.word.size() <= 100))
        && (!data.keys().contains('category') || (data.category is string && data.category.size() > 0 && data.category.size() <= 50))
        && (!data.keys().contains('definition') || (data.definition is string && data.definition.size() > 0 && data.definition.size() <= 2000))
        && (!data.keys().contains('examples') || (data.examples is list && data.examples.size() <= 10))
        && (!data.keys().contains('etymology') || (data.etymology is string && data.etymology.size() <= 1000))
        && (!data.keys().contains('updatedAt') || data.updatedAt is string)
        && (!data.keys().contains('searchCount') || data.searchCount is int);
    }

    // Evaluates checks and stats logged securely
    function isValidEvaluation(data) {
      return data.keys().size() <= 7
        && (!data.keys().contains('email') || (data.email is string && data.email.size() <= 128))
        && (!data.keys().contains('totalWords') || data.totalWords is int)
        && (!data.keys().contains('typosCount') || data.typosCount is int)
        && (!data.keys().contains('precision') || (data.precision is string && data.precision.size() <= 20))
        && (!data.keys().contains('inputText') || (data.inputText is string && data.inputText.size() <= 100000))
        && (!data.keys().contains('timestamp') || data.timestamp is string);
    }

    // Fully flexible user mapping (to avoid merge update issues on missing values)
    function isValidTypoUser(data) {
      return data.keys().size() <= 6
        && (!data.keys().contains('email') || (data.email is string && data.email.size() <= 128))
        && (!data.keys().contains('usageCount') || data.usageCount is number)
        && (!data.keys().contains('paymentStatus') || (data.paymentStatus is string && data.paymentStatus.size() <= 20))
        && (!data.keys().contains('allowedLimit') || data.allowedLimit is number);
    }

    // Payment logs
    function isValidPayment(data) {
      return data.keys().size() <= 6
        && (!data.keys().contains('email') || (data.email is string && data.email.size() <= 128))
        && (!data.keys().contains('amount') || data.amount is number)
        && (!data.keys().contains('status') || (data.status is string && data.status.size() <= 20))
        && (!data.keys().contains('requestedAt') || data.requestedAt is string)
        && (!data.keys().contains('approvedAt') || data.approvedAt is string);
    }

    // Global settings configurations
    function isValidSettings(data) {
      return data.keys().size() <= 4
        && (!data.keys().contains('gopayNumber') || (data.gopayNumber is string && data.gopayNumber.size() <= 50))
        && (!data.keys().contains('qrisImageUrl') || (data.qrisImageUrl is string && data.qrisImageUrl.size() <= 1500000))
        && (!data.keys().contains('amount') || data.amount is number);
    }

    // White-listed items can bypass checks
    function isValidBypassEmail(data) {
      return data.keys().size() <= 5
        && (!data.keys().contains('email') || (data.email is string && data.email.size() <= 128))
        && (!data.keys().contains('isActive') || data.isActive is bool)
        && (!data.keys().contains('createdAt') || data.createdAt is string);
    }

    // Typo dictionary entries
    function isValidTypoCorrection(data) {
      return data.keys().size() <= 4
        && (!data.keys().contains('typo') || (data.typo is string && data.typo.size() > 0 && data.typo.size() <= 100))
        && (!data.keys().contains('correction') || (data.correction is string && data.correction.size() > 0 && data.correction.size() <= 100))
        && (!data.keys().contains('updatedAt') || data.updatedAt is string);
    }

    // Products offered in Pustaka Digital
    function isValidLibraryProduct(data) {
      return data.keys().size() <= 10
        && (!data.keys().contains('title') || (data.title is string && data.title.size() <= 200))
        && (!data.keys().contains('description') || (data.description is string && data.description.size() <= 2000))
        && (!data.keys().contains('format') || (data.format is string && data.format.size() <= 10))
        && (!data.keys().contains('price') || data.price is number)
        && (!data.keys().contains('contentUrl') || (data.contentUrl is string && data.contentUrl.size() <= 1050000));
    }

    // Library sales logs
    function isValidLibraryPayment(data) {
      return data.keys().size() <= 11
        && (!data.keys().contains('customerName') || (data.customerName is string && data.customerName.size() <= 128))
        && (!data.keys().contains('customerPhone') || (data.customerPhone is string && data.customerPhone.size() <= 50))
        && (!data.keys().contains('customerEmail') || (data.customerEmail is string && data.customerEmail.size() <= 128))
        && (!data.keys().contains('productId') || (data.productId is string && data.productId.size() <= 128))
        && (!data.keys().contains('amount') || data.amount is number)
        && (!data.keys().contains('status') || (data.status is string && data.status.size() <= 50))
        && (!data.keys().contains('requestedAt') || data.requestedAt is string)
        && (!data.keys().contains('approvedAt') || data.approvedAt is string);
    }

    // --- PHASE 4: Match collections ---

    // Words collection
    match /words/{wordId} {
      allow read: if true;
      allow create: if isValidId(wordId) && isValidWord(incoming());
      allow update: if isValidWord(incoming())
        || (
          incoming().diff(existing()).affectedKeys().hasOnly(['searchCount'])
        );
      allow delete: if true;
    }

    // Typos collection
    match /typos/{typoId} {
      allow read: if true;
      allow create, update: if isValidId(typoId) && isValidTypoCorrection(incoming());
      allow delete: if true;
    }

    // Stats collection
    match /stats/{statId} {
      allow read: if true;
      allow create, update: if isValidId(statId) 
        && (incoming().keys().size() <= 3)
        && (!incoming().keys().contains('totalSearches') || incoming().totalSearches is number)
        && (!incoming().keys().contains('totalInstalls') || incoming().totalInstalls is number);
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if true;
      allow write: if true;
    }

    // Evaluations
    match /evaluations/{evalId} {
      allow create: if isValidId(evalId) && isValidEvaluation(incoming());
      allow read, update, delete: if true;
    }

    // Users (typo usage tracking)
    match /users/{emailId} {
      allow read: if true;
      allow create, update: if isValidId(emailId) && isValidTypoUser(incoming());
      allow delete: if true;
    }

    // Payments logs
    match /payments/{paymentId} {
      allow create: if isValidId(paymentId) && isValidPayment(incoming());
      allow read, update, delete: if true;
    }

    // Settings
    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if isValidId(settingId) && isValidSettings(incoming());
      allow delete: if true;
    }

    // Bypass Whitelist Emails
    match /bypass_emails/{id} {
      allow read: if true;
      allow create, update: if isValidId(id) && isValidBypassEmail(incoming());
      allow delete: if true;
    }

    // Library Products
    match /library_products/{productId} {
      allow read: if true;
      allow create, update: if isValidId(productId) && isValidLibraryProduct(incoming());
      allow delete: if true;
    }

    // Library Payments
    match /library_payments/{paymentId} {
      allow read: if true;
      allow create, update: if isValidId(paymentId) && isValidLibraryPayment(incoming());
      allow delete: if true;
    }
  }
}
